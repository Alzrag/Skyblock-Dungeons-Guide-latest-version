diff --git a/mod/src/main/java/kr/syeyoung/dungeonsguide/mod/pathfinding/precalculation/PathfindPrecalculation.java b/mod/src/main/java/kr/syeyoung/dungeonsguide/mod/pathfinding/precalculation/PathfindPrecalculation.java
index cd3dc1f..8d9d4f2 100644
--- a/mod/src/main/java/kr/syeyoung/dungeonsguide/mod/pathfinding/precalculation/PathfindPrecalculation.java
+++ b/mod/src/main/java/kr/syeyoung/dungeonsguide/mod/pathfinding/precalculation/PathfindPrecalculation.java
@@ -11,0 +12 @@ import java.lang.ref.SoftReference;
+import java.lang.reflect.Field;
@@ -166,6 +167,11 @@ public class PathfindPrecalculation {
-            Method cleanerMethod = toBeDestroyed.getClass().getMethod("cleaner");
-            cleanerMethod.setAccessible(true);
-            Object cleaner = cleanerMethod.invoke(toBeDestroyed);
-            Method cleanMethod = cleaner.getClass().getMethod("clean");
-            cleanMethod.setAccessible(true);
-            cleanMethod.invoke(cleaner);
+            // the old reflective DirectByteBuffer.cleaner() access is blocked on modern java (java.base does not open
+            // java.nio), Unsafe.invokeCleaner is the supported way to free a direct buffer. if even that is unavailable
+            // the buffer is just left to the GC, which is harmless
+            try {
+                Field f = Class.forName("sun.misc.Unsafe").getDeclaredField("theUnsafe");
+                f.setAccessible(true);
+                Object unsafe = f.get(null);
+                unsafe.getClass().getMethod("invokeCleaner", ByteBuffer.class).invoke(unsafe, toBeDestroyed);
+            } catch (ReflectiveOperationException | RuntimeException e) {
+                // leave it to the GC
+            }
